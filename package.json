{
  "name": "cqai-dsh-plugin-research",
  "version": "0.2.2",
  "description": "e研宝：把 academic-research-skills 的四套学术技能接成易宝工坊里的数字员工。",
  "icon": "assets/icon.svg",
  "license": "(MIT AND CC-BY-NC-4.0)",
  "homepage": "https://github.com/cqai-club/cqai-dsh-plugin-research#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqai-club/cqai-dsh-plugin-research.git"
  },
  "bugs": {
    "url": "https://github.com/cqai-club/cqai-dsh-plugin-research/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "academic"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/**",
    "assets/**",
    "locale/**",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "安装说明.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "check:release": "node scripts/check-release.mjs",
    "configure:portal": "node scripts/configure-portal-draft.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "vitest": "4.1.11"
  }
}
